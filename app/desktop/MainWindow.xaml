<Window x:Class="Central.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Central.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Central Colaborativa"
        Width="1440"
        Height="900"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}"
        AutomationProperties.Name="Central Colaborativa">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarShell"
                Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid x:Name="SidebarContent" Margin="8,12,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="BrandRow" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BrandIdentity" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BrandMark" Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <Path Data="M23,7 H14 C8,7 5,10 5,16 S8,25 14,25 H23"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2.1"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Margin="6" />
                        </Border>
                        <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CENTRAL" FontFamily="{StaticResource AppleDisplayFont}" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="COORDENAÇÃO DE IA" Style="{StaticResource CaptionText}" FontSize="8" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CollapseSidebarButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="8"
                            ToolTip="Abrir menu lateral"
                            AutomationProperties.Name="Abrir menu lateral"
                            Style="{StaticResource QuietButton}"
                            Click="ToggleSidebar_Click">
                        <Path x:Name="SidebarToggleIcon"
                               Data="M5,5 H12 V19 H5 Z M12,12 H19 M16,9 L19,12 L16,15"
                              Stroke="{StaticResource MutedTextBrush}"
                              StrokeThickness="1.75"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform" />
                    </Button>
                </Grid>

                <StackPanel x:Name="NavigationStack" Grid.Row="1" Margin="0,20,0,0">
                    <TextBlock x:Name="NavigateCaption" Text="NAVEGAÇÃO" Style="{StaticResource CaptionText}" FontSize="9" Margin="5,0,0,7" />
                    <Button x:Name="DashboardNav" Tag="Dashboard" ToolTip="Home" AutomationProperties.Name="Home" Style="{StaticResource NavButton}" Click="Navigation_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="M4,11 L12,4 L20,11 V20 H4 Z M9,20 V14 H15 V20"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.75" StrokeLineJoin="Round" Stretch="Uniform" Margin="1" />
                            <TextBlock x:Name="DashboardLabel" Grid.Column="1" Text="Home" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="ProjectsNav" Tag="Projects" ToolTip="Projetos" AutomationProperties.Name="Projetos" Style="{StaticResource NavButton}" Click="Navigation_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="M3,6 H10 L12,9 H21 V20 H3 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.75" StrokeLineJoin="Round" Stretch="Uniform" Margin="1" />
                            <TextBlock x:Name="ProjectsLabel" Grid.Column="1" Text="Projetos" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Background="{StaticResource LineBrush}" Height="1" Margin="7,16,7,16" />
                    <TextBlock x:Name="ContextCaption" Text="CONTEXTO" Style="{StaticResource CaptionText}" FontSize="9" Margin="5,0,0,7" />
                    <Button x:Name="ProjectNav" Tag="Project" ToolTip="Projeto selecionado" AutomationProperties.Name="Projeto selecionado" Style="{StaticResource NavButton}" Click="Navigation_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="M5,4 H15 L19,8 V20 H5 Z M15,4 V9 H19"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.75" StrokeLineJoin="Round" Stretch="Uniform" Margin="1" />
                            <TextBlock x:Name="ProjectLabel" Grid.Column="1" Text="Projeto" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Button x:Name="UserSettingsButton"
                        Grid.Row="2"
                        ToolTip="Configurações"
                        AutomationProperties.Name="Abrir configurações"
                        Style="{StaticResource QuietButton}"
                        HorizontalContentAlignment="Stretch"
                        Padding="8"
                        Click="OpenSettings_Click">
                    <Grid x:Name="UserSettingsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="UserAvatarColumn" Width="32" />
                            <ColumnDefinition x:Name="UserTextColumn" Width="*" />
                            <ColumnDefinition x:Name="UserSettingsColumn" Width="28" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="UserAvatar" Width="28" Height="28" CornerRadius="6" Background="{StaticResource BlueSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBlock Text="LD" Foreground="{StaticResource BlueBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="UserText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Local developer" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Administrador local" Style="{StaticResource CaptionText}" FontSize="9" />
                        </StackPanel>
                        <Path x:Name="SettingsGlyph" Grid.Column="2"
                              Data="M12,3 L13.4,5.1 A7.2,7.2 0 0 1 15.4,5.9 L17.8,5.2 L19.6,7 L18.9,9.4 A7.2,7.2 0 0 1 19.7,11.4 L21.8,12.8 V15.2 L19.7,16.6 A7.2,7.2 0 0 1 18.9,18.6 L19.6,21 L17.8,22.8 L15.4,22.1 A7.2,7.2 0 0 1 13.4,22.9 L12,25 H9.6 L8.2,22.9 A7.2,7.2 0 0 1 6.2,22.1 L3.8,22.8 L2,21 L2.7,18.6 A7.2,7.2 0 0 1 1.9,16.6 L0,15.2 V12.8 L1.9,11.4 A7.2,7.2 0 0 1 2.7,9.4 L2,7 L3.8,5.2 L6.2,5.9 A7.2,7.2 0 0 1 8.2,5.1 L9.6,3 Z M11,9 A3,3 0 1 0 11,15 A3,3 0 0 0 11,9"
                              Stroke="{StaticResource MutedTextBrush}"
                              StrokeThickness="1.35"
                              Stretch="Uniform"
                              Margin="6" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Central / " Style="{StaticResource MutedText}" FontSize="12" />
                    <TextBlock x:Name="HeaderTitle" Text="Home" FontFamily="{StaticResource AppleDisplayFont}" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="14,0,0,0" ToolTip="{Binding GatewayStatusDetail}" AutomationProperties.Name="Status do servidor">
                        <TextBlock Text="{Binding GatewayStatusLabel}" Foreground="{StaticResource BlueBrush}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="6,0,0,0" ToolTip="{Binding SyncStatusDetail}" AutomationProperties.Name="Status da sincronização">
                        <TextBlock Text="{Binding SyncStatusLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button AutomationProperties.Name="Minimizar janela" ToolTip="Minimizar" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="10" Click="Minimize_Click">
                        <Path Data="M4,12 H20" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Uniform" />
                    </Button>
                    <Button AutomationProperties.Name="Maximizar ou restaurar janela" ToolTip="Maximizar ou restaurar" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="10" Click="Maximize_Click">
                        <Path Data="M5,5 H19 V19 H5 Z" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Stretch="Uniform" />
                    </Button>
                    <Button AutomationProperties.Name="Fechar janela" ToolTip="Fechar" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="10" Click="Close_Click">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}">
                <ContentControl x:Name="ContentHost" Focusable="True" AutomationProperties.Name="Página atual" />

                <Border x:Name="ToastBorder"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,20"
                        Background="{StaticResource SuccessSoftBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="13,10"
                        MaxWidth="520"
                        Visibility="Collapsed"
                        Panel.ZIndex="30"
                        AutomationProperties.Name="Resultado da operação">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                        <TextBlock Grid.Column="1" x:Name="ToastText" TextWrapping="Wrap" FontSize="12" Margin="8,0,16,0" />
                        <Button Grid.Column="2" x:Name="DismissToastButton" AutomationProperties.Name="Dispensar mensagem" Style="{StaticResource QuietButton}" Padding="4,0" Click="DismissToast_Click">
                            <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <local:AutomationStateGrid x:Name="LoginOverlay"
              Grid.ColumnSpan="2"
              Background="{StaticResource WindowBackgroundBrush}"
              Visibility="Visible"
              Panel.ZIndex="50"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="Login da Central"
              AutomationProperties.IsDialog="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="1040" Margin="28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                        <Path Data="M23,7 H14 C8,7 5,10 5,16 S8,25 14,25 H23" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="7" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CENTRAL" FontFamily="{StaticResource AppleDisplayFont}" FontSize="13" FontWeight="Bold" />
                                        <TextBlock Text="ACESSO CONTROLADO" Style="{StaticResource CaptionText}" FontSize="8" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Entre com o vínculo Peace" Style="{StaticResource SectionTitle}" FontSize="27" Margin="0,28,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="O bot do Discord confirma sua identidade. A Central só abre uma sessão curta depois que o vínculo e o código forem verificados." Style="{StaticResource SubtitleText}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,28,0,28">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BlueSoftBrush}"><TextBlock Text="1" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Discord confirma" FontWeight="SemiBold" /><TextBlock Text="A conta e o cargo técnico são a fonte da identidade." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BlueSoftBrush}"><TextBlock Text="2" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Peace ID vincula" FontWeight="SemiBold" /><TextBlock Text="O identificador evita confiar em um nome digitado." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BlueSoftBrush}"><TextBlock Text="3" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Código único" FontWeight="SemiBold" /><TextBlock Text="O código chega por DM e não deve aparecer em canais públicos." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <Border Background="{StaticResource AmberSoftBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <TextBlock Text="INTERFACE EM PREPARAÇÃO · nenhuma credencial ou mensagem é enviada nesta demonstração." Style="{StaticResource CaptionText}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="A autenticação real com Discord, DM e serviço de troca ainda será conectada em uma etapa posterior." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border x:Name="LoginStep1" Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border x:Name="LoginStep2" Width="26" Height="26" CornerRadius="13" Background="{StaticResource SurfaceBrush}" Margin="8,0,0,0"><TextBlock Text="2" Foreground="{StaticResource SubtleTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border x:Name="LoginStep3" Width="26" Height="26" CornerRadius="13" Background="{StaticResource SurfaceBrush}" Margin="8,0,0,0"><TextBlock Text="3" Foreground="{StaticResource SubtleTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border x:Name="LoginStep4" Width="26" Height="26" CornerRadius="13" Background="{StaticResource SurfaceBrush}" Margin="8,0,0,0"><TextBlock Text="4" Foreground="{StaticResource SubtleTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                </StackPanel>
                                <TextBlock x:Name="LoginStepKicker" Text="ETAPA 1 DE 4" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
                                <TextBlock x:Name="LoginTitle" Text="Comece pelo Discord" Style="{StaticResource SectionTitle}" FontSize="25" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="LoginDescription" Text="Use o vínculo da Peace para iniciar o acesso à Central." Style="{StaticResource SubtitleText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,28,0,20">
                                <StackPanel x:Name="LoginStageWelcome">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="O que acontece agora" FontWeight="SemiBold" />
                                            <TextBlock Text="Você será identificado pelo Discord, informará o Peace ID e verá a etapa do código enviado por DM." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="LoginDiscordButton" Content="Continuar com Discord" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Height="42" Margin="0,20,0,0" Click="LoginDiscord_Click" AutomationProperties.Name="Continuar com Discord" />
                                    <TextBlock Text="Sem senha do Discord. A Central nunca recebe o token do bot." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="LoginStageIdentity" Visibility="Collapsed">
                                    <TextBlock Text="Seu Peace ID" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                    <TextBlock Text="Informe apenas o identificador vinculado à sua conta no servidor." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBox x:Name="LoginPeaceIdTextBox" Style="{StaticResource TextBoxStyle}" Height="42" MaxLength="32" Margin="0,18,0,0" AutomationProperties.Name="Peace ID" />
                                    <TextBlock x:Name="LoginIdentityValidation" Text="" Foreground="{StaticResource RedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <Button Content="Solicitar código por DM" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Height="42" Margin="0,18,0,0" Click="LoginRequestCode_Click" AutomationProperties.Name="Solicitar código por mensagem direta" />
                                    <Button Content="Voltar" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="LoginBack_Click" AutomationProperties.Name="Voltar para o início do login" />
                                </StackPanel>

                                <StackPanel x:Name="LoginStageCode" Visibility="Collapsed">
                                    <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Código solicitado" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="Na integração real, o bot enviaria um código temporário por DM. Ele não seria exibido em canais, logs ou snapshots." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Código de 6 dígitos" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" Margin="0,20,0,0" />
                                    <TextBox x:Name="LoginCodeTextBox" Style="{StaticResource TextBoxStyle}" Height="42" MaxLength="6" Margin="0,6,0,0" AutomationProperties.Name="Código recebido por mensagem direta" />
                                    <TextBlock x:Name="LoginCodeValidation" Text="" Foreground="{StaticResource RedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <Button Content="Confirmar código" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Height="42" Margin="0,18,0,0" Click="LoginConfirmCode_Click" AutomationProperties.Name="Confirmar código de login" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Voltar" Style="{StaticResource QuietButton}" Click="LoginBack_Click" AutomationProperties.Name="Voltar para o Peace ID" />
                                        <Button Content="Reenviar código" Style="{StaticResource QuietButton}" Margin="8,0,0,0" IsEnabled="False" ToolTip="Disponível quando o serviço real estiver conectado" AutomationProperties.Name="Reenviar código indisponível" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="LoginStageReady" Visibility="Collapsed">
                                    <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Fluxo visual concluído" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="A próxima ação da integração real seria trocar o desafio por uma sessão curta com escopo de projeto." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Nenhuma sessão foi criada nesta interface." Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                                    <Button x:Name="LoginRestartButton" Content="Recomeçar demonstração" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="LoginRestart_Click" AutomationProperties.Name="Recomeçar demonstração de login" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="central-login · interface somente visual" Style="{StaticResource CaptionText}" Foreground="{StaticResource SubtleTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </local:AutomationStateGrid>

        <local:AutomationStateGrid x:Name="SettingsOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="40"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="Configurações abertas">
            <Border x:Name="SettingsScrim" Background="{StaticResource ScrimBrush}" />
            <local:AutomationDialogBorder x:Name="SettingsPanel"
                    Width="420"
                    MaxHeight="540"
                    MaxWidth="700"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanel}"
                    AutomationProperties.Name="Configurações"
                    AutomationProperties.LabeledBy="{Binding ElementName=SettingsTitle}"
                    AutomationProperties.IsDialog="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="470">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="SettingsTitle" Text="Preferências" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="Ajustes locais da Central" Style="{StaticResource SubtitleText}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="CloseSettingsButton" AutomationProperties.Name="Fechar configurações" ToolTip="Fechar" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Width="36" Height="36" Padding="10" Click="CloseSettings_Click">
                            <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="APARÊNCIA" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                            <CheckBox x:Name="ReducedMotionCheckBox" Content="Reduzir movimento" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" AutomationProperties.Name="Reduzir movimento" Checked="ReducedMotion_Changed" Unchecked="ReducedMotion_Changed" />
                            <TextBlock Text="Mantém mudanças e seleções claras sem transições decorativas." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="INTEGRAÇÕES" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                        <TextBlock Text="Claude, Codex e MCP continuam desligados. A pasta de arquivos e os eventos de coordenação agora têm uma integração real opcional, com identidade e estado explícitos." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="CONEXÃO DO PROJETO" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                <TextBlock Text="Esses dados ficam salvos somente neste Windows. A senha permanece apenas na memória e nunca é gravada no arquivo de preferências." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8" />
                                <TextBlock Text="URL do Supabase" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncSupabaseUrlTextBox" Text="{Binding SyncSupabaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="URL do Supabase" />
                                <TextBlock Text="Chave publishable" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncPublishableKeyTextBox" Text="{Binding SyncPublishableKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="Chave publishable do Supabase" />
                                <TextBlock Text="E-mail" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncEmailTextBox" Text="{Binding SyncEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="E-mail do Supabase" />
                                <TextBlock Text="Senha" Style="{StaticResource CaptionText}" />
                                <PasswordBox x:Name="SyncPasswordBox" Margin="0,3,0,7" Padding="10,8" Foreground="{StaticResource TextBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" AutomationProperties.Name="Senha do Supabase" />
                                <TextBlock Text="ID da organização" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncOrganizationIdTextBox" Text="{Binding SyncOrganizationId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="ID da organização" />
                                <TextBlock Text="ID do projeto" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncProjectIdTextBox" Text="{Binding SyncProjectId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="ID do projeto" />
                                <TextBlock Text="Pasta local dedicada" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="SyncFolderTextBox" Text="{Binding SyncFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,3,0,7" AutomationProperties.Name="Pasta local dedicada" />
                                <TextBlock Text="Modo desta instalação" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="SyncModeComboBox" ItemsSource="{Binding SyncModes}" SelectedItem="{Binding SyncMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" Padding="8,6" Foreground="{StaticResource TextBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" AutomationProperties.Name="Modo de sincronização" />
                                <TextBlock Text="Para o segundo PC, comece em receive-only. Depois de confirmar arquivo e hash nos dois lados, reconecte em send-receive se a equipe realmente precisar de duas vias." Style="{StaticResource CaptionText}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="SINCRONIZAÇÃO REAL · SYNCTHING + SUPABASE REALTIME" Style="{StaticResource CaptionText}" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding SyncStatusLabel}" FontSize="12" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding SyncStatusDetail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button Content="Conectar este computador" AutomationProperties.Name="Conectar este computador" Style="{StaticResource AccentButton}" Click="ConnectSync_Click" />
                                    <Button Content="Pausar" AutomationProperties.Name="Pausar sincronização" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="PauseSync_Click" />
                                </StackPanel>
                                <TextBlock Text="A senha é enviada somente ao Auth do Supabase para criar a sessão. O gateway PythonAnywhere não recebe arquivos nem credenciais. Sem conexão autenticada, nenhum arquivo é configurado." Style="{StaticResource CaptionText}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="SMOKE TEST DO SERVIDOR" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                <TextBlock Text="{Binding GatewayStatusLabel}" FontSize="12" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding GatewayStatusDetail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding GatewayUrl}" Style="{StaticResource CaptionText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Button Content="Verificar agora" AutomationProperties.Name="Verificar servidor agora" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="CheckGateway_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </local:AutomationDialogBorder>
        </local:AutomationStateGrid>
    </Grid>
</Window>
