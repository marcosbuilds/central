<Application x:Class="Central.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Central.Desktop"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Semantic palette: dark canvas, quiet surfaces, explicit state colors. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090D11" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C1216" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#11181D" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#172129" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#1C2932" />
        <SolidColorBrush x:Key="LineBrush" Color="#293943" />
        <SolidColorBrush x:Key="TextBrush" Color="#F6FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B1BDC7" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#7B8A95" />
        <SolidColorBrush x:Key="AccentBrush" Color="#CFFF4E" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B3C1A" />
        <SolidColorBrush x:Key="BlueBrush" Color="#7EA9FF" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#202F4E" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#42D6AE" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#173F38" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F2B660" />
        <SolidColorBrush x:Key="AmberSoftBrush" Color="#46331D" />
        <SolidColorBrush x:Key="RedBrush" Color="#F17E86" />
        <SolidColorBrush x:Key="RedSoftBrush" Color="#45242D" />
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
        <!-- Action text is intentionally dark: the lime action surface must remain
             legible instead of inheriting the muted light text used elsewhere. -->
        <SolidColorBrush x:Key="InkBrush" Color="#071006" />
        <SolidColorBrush x:Key="ScrimBrush" Color="#B8000000" />

        <!-- Typography: SF Pro is the preferred Apple display face when available;
             Windows falls back to its native variable UI face. Seloryn is bundled
             locally from the project's MIT-licensed release asset. -->
        <FontFamily x:Key="AppleDisplayFont">SF Pro Display, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="AppleTextFont">SF Pro Text, Segoe UI Variable, Segoe UI</FontFamily>
        <FontFamily x:Key="SelorynFont">/Central;component/Assets/Fonts/Seloryn/#Seloryn Font</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppleTextFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="{StaticResource AppleTextFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <!-- Seloryn is a brand/subtitle face, not a microcopy face. Dense labels
                 stay in the platform text face so scanning remains reliable. -->
            <Setter Property="FontFamily" Value="{StaticResource AppleTextFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontFamily" Value="{StaticResource SelorynFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource AppleDisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="38" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource AppleDisplayFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="DialogPanel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="SoftCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        </Style>

        <Style x:Key="PillBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppleTextFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.68" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <!-- A string presented by ContentPresenter can otherwise inherit the
                 global light TextBlock style. Bind the actual text node to the
                 button state so lime actions always use readable dark ink, while
                 disabled actions still receive their muted foreground. -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SubtleTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppleTextFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BlueBrush}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource WhiteBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SelorynFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contained, high-contrast scrollbars: the page never borrows the OS
             white scrollbar and data tables may still opt into local horizontal scroll. -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource BlueBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" IsTabStop="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" IsTabStop="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Opacity="0" IsTabStop="False" /></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" /></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.LineRightCommand}" Opacity="0" IsTabStop="False" /></Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource SubtleTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="open"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="active"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="done"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="ready"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="review"><Setter Property="Fill" Value="{StaticResource AmberBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="transition"><Setter Property="Fill" Value="{StaticResource AmberBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="blocked"><Setter Property="Fill" Value="{StaticResource RedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="closed"><Setter Property="Fill" Value="{StaticResource SubtleTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="offline"><Setter Property="Fill" Value="{StaticResource SubtleTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityDotStyle" TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="accent"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="blue"><Setter Property="Fill" Value="{StaticResource BlueBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="amber"><Setter Property="Fill" Value="{StaticResource AmberBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="blocked"><Setter Property="Fill" Value="{StaticResource RedBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource SubtleTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanAndConverter x:Key="BooleanAndConverter" />
    </Application.Resources>
</Application>
