<UserControl x:Class="Central.Desktop.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0">
    <Grid Margin="28,18,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="PROJETO" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                <TextBlock Text="{Binding SelectedProject.Name}" FontFamily="{StaticResource AppleDisplayFont}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SelectedProject.Id}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock Text="fixture local · gateway ausente" Style="{StaticResource CaptionText}" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource PillBorder}" Background="{StaticResource SurfaceRaisedBrush}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding SelectedProject}">
                        <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PillBorder}" Background="{StaticResource BlueSoftBrush}" Margin="0,0,8,0">
                    <TextBlock Text="{Binding SelectedProject.WorkspaceRevisionLabel}" Foreground="{StaticResource BlueBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" />
                </Border>
                <Button x:Name="LifecycleButton" AutomationProperties.Name="Alterar ciclo de vida do projeto" Style="{StaticResource QuietButton}" Click="LifecycleButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="ProjectTabs" Grid.Row="1" Margin="0,18,0,0" SelectionChanged="ProjectTabs_SelectionChanged" AutomationProperties.Name="Modos do projeto">
            <TabItem x:Name="OperateTab" Header="Operar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="OperateSurface" Style="{StaticResource PanelBorder}" Padding="20" Margin="0,14,0,24" VerticalAlignment="Top">
                        <Grid x:Name="OperateGrid" SizeChanged="OperateGrid_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="OperateDecisionPanel" Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="PRÓXIMA DECISÃO" Style="{StaticResource CaptionText}" Foreground="{StaticResource AmberBrush}" />
                                <TextBlock Text="{Binding SelectedProject.NextActionableTask.Title, TargetNullValue=Nenhuma tarefa pronta}" FontFamily="{StaticResource AppleDisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedProject.NextActionableTask.Description, TargetNullValue=Não há tarefa pronta nesta fixture.}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="STATUS" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SelectedProject.NextActionableTask.StatusLabel, TargetNullValue=—}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="ÁREA" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SelectedProject.NextActionableTask.Area, TargetNullValue=—}" FontFamily="{StaticResource MonoFont}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="DEPENDÊNCIA" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SelectedProject.NextActionableTask.Dependency, TargetNullValue=—}" FontFamily="{StaticResource MonoFont}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                                </Grid>
                                <Button Content="Abrir no Workspace" AutomationProperties.Name="Abrir a tarefa no Workspace" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenWorkspace_Click" />
                            </StackPanel>

                            <Border x:Name="OperateBlockerPanel" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="BLOQUEIOS" Style="{StaticResource CaptionText}" Foreground="{StaticResource RedBrush}" />
                                    <TextBlock Text="{Binding SelectedProject.BlockedTaskCount}" FontFamily="{StaticResource AppleDisplayFont}" FontSize="42" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="tarefas bloqueadas" Style="{StaticResource MutedText}" FontSize="12" />
                                    <TextBlock Text="Resolva a dependência no Workspace antes de reservar." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="OperateActivityPanel" Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="ATIVIDADE" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedProject.Activity}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" />
                                                    <Ellipse Grid.Column="1" Style="{StaticResource ActivityDotStyle}" Margin="3,4,0,0" />
                                                    <StackPanel Grid.Column="2" Margin="8,0,10,0"><TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Actor}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="WorkspaceTab" Header="Workspace">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,24" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource SectionTitle}" Margin="0" /><TextBlock Text="Tarefas, artefatos e pulso no mesmo contexto." Style="{StaticResource SubtitleText}" FontSize="12" /></StackPanel>
                                <TextBlock Text="{Binding SelectedProject.WorkspaceVersioningLabel}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>

                            <Grid x:Name="WorkspaceTopGrid" Margin="0,18,0,0" SizeChanged="WorkspaceGrid_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="0.72*" /></Grid.ColumnDefinitions>

                                <Border x:Name="WorkspaceFilesPanel" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="ARQUIVOS" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                        <ItemsControl ItemsSource="{Binding SelectedProject.WorkspaceFiles}" Margin="0,9,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="WorkspaceFile_Click" AutomationProperties.Name="{Binding Path}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="6,7" Margin="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource SurfaceSoftBrush}"><TextBlock Text="{Binding FileTypeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DirectoryLabel}" Style="{StaticResource CaptionText}" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="WorkspaceInspectorPanel" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="18,0" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="ARQUIVO SELECIONADO" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding SelectedProject.SelectedWorkspaceFile.Path, TargetNullValue=Selecione um arquivo}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding SelectedProject.SelectedWorkspaceFile.Description, TargetNullValue=Sem descrição no manifesto.}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding SelectedProject.SelectedWorkspaceFile.PreviewContent, TargetNullValue=O conteúdo do arquivo aparecerá aqui quando houver um item selecionado.}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                        <Grid Margin="0,14,0,0"><TextBlock Text="{Binding SelectedProject.SelectedWorkspaceFile.Owner, TargetNullValue=owner não declarado}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SelectedProject.SelectedWorkspaceFile.RevisionLabel, TargetNullValue=—}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Foreground="{StaticResource BlueBrush}" /></Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="WorkspaceMetaPanel" Grid.Column="2" Margin="5,0,0,0">
                                    <TextBlock Text="METADADOS" Style="{StaticResource CaptionText}" Foreground="{StaticResource AmberBrush}" />
                                    <TextBlock Text="TAGS" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedProject.WorkspaceTags}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="Tag_Click" AutomationProperties.Name="{Binding AccessibleLabel}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="4,4" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="RELEASES" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedProject.WorkspaceReleases}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="Release_Click" AutomationProperties.Name="{Binding AccessibleLabel}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="4,4" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="COLABORADORES" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" Margin="0,14,0,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedProject.ActiveSessions}" Margin="0,7,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Style="{StaticResource ConnectionDotStyle}" Margin="0,4,0,0" DataContext="{Binding}" />
                                                    <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource CaptionText}" FontSize="8" TextWrapping="Wrap" /></StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="WorkspaceLowerGrid" Margin="0,18,0,0" SizeChanged="WorkspaceGrid_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                <Border x:Name="WorkspaceTasksPanel" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0" Padding="14,14,14,0" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="TAREFAS E RESERVAS" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                        <ItemsControl ItemsSource="{Binding SelectedProject.Tasks}" Margin="0,9,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="Task_Click" AutomationProperties.Name="{Binding AccessibleLabel}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="6,7" Margin="0,0,0,1">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Style="{StaticResource StatusDotStyle}" Margin="2,5,0,0" /><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BlueBrush}" FontSize="10" /><TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Style="{StaticResource CaptionText}" FontSize="9" /></Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="WorkspaceCommitsPanel" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,14,0,0" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="COMMITS LOCAIS" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" />
                                        <ItemsControl ItemsSource="{Binding SelectedProject.WorkspaceCommits}" Margin="0,9,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="Commit_Click" AutomationProperties.Name="{Binding AccessibleLabel}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="6,7" Margin="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding RevisionLabel}" Style="{StaticResource CaptionText}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid><TextBlock Text="PULSO LOCAL" Style="{StaticResource CaptionText}" Foreground="{StaticResource BlueBrush}" /><TextBlock Text="fila manual · não é streaming" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" /></Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedProject.StreamEvents}" Margin="0,9,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Click="StreamEvent_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="6,7" Margin="0,0,0,1">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SequenceLabel}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BlueBrush}" /><StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding ActorLabel}" Style="{StaticResource CaptionText}" FontSize="9" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding OperationLabel}" Style="{StaticResource CaptionText}" FontSize="9" /></Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Avançar evento local" AutomationProperties.Name="Avançar evento local" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" IsEnabled="{Binding SelectedProject.IsOpen}" Margin="0,10,0,0" Click="AdvanceSimulation_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CoordinationTab" Header="Coordenação">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,24" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="COORDENAÇÃO" Style="{StaticResource SectionTitle}" Margin="0" /><TextBlock Text="Thread local; referências abrem objetos conhecidos." Style="{StaticResource SubtitleText}" FontSize="12" /></StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedProject.Discussions}" Margin="0,16,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BlueSoftBrush}"><TextBlock Text="{Binding Initials}" Foreground="{StaticResource BlueBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="  ·  " Style="{StaticResource CaptionText}" FontSize="10" /><TextBlock Text="{Binding MessageType}" Style="{StaticResource CaptionText}" FontSize="10" /></StackPanel><TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" /><ItemsControl ItemsSource="{Binding References}" Margin="0,7,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Click="Reference_Click" AutomationProperties.Name="{Binding AccessibleLabel}" Style="{StaticResource QuietButton}" Padding="7,4" Margin="0,0,5,4" IsEnabled="{Binding IsResolvable}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="PENDENTE · nenhuma resposta foi inventada" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,3,0,0" Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource CaptionText}" FontSize="10" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DiscussionBox" Grid.Column="0" MinHeight="48" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource TextBoxStyle}" AutomationProperties.Name="Mensagem para a thread local" /><Button Grid.Column="1" Content="Enviar" AutomationProperties.Name="Registrar mensagem na thread" Style="{StaticResource AccentButton}" Margin="10,0,0,0" VerticalAlignment="Top" IsEnabled="{Binding SelectedProject.IsOpen}" Click="PostDiscussion_Click" /></Grid>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ProveTab" Header="Provar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,24" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid><StackPanel><TextBlock Text="PROVAR" Style="{StaticResource SectionTitle}" Margin="0" /><TextBlock Text="Evidência, checks e publicação permanecem gates distintos." Style="{StaticResource SubtitleText}" FontSize="12" /></StackPanel><Button Content="Criar rascunho" AutomationProperties.Name="Criar rascunho local" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" IsEnabled="{Binding SelectedProject.IsOpen}" Click="CreateDelivery_Click" /></Grid>
                            <ItemsControl ItemsSource="{Binding SelectedProject.Deliveries}" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                     <DataTemplate>
                                         <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                             <StackPanel>
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <StackPanel><TextBlock Text="{Binding Id}" Foreground="{StaticResource BlueBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding Hash}" Style="{StaticResource CaptionText}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                                     <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding GateLabel}" Style="{StaticResource CaptionText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" /><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,7,0" /><TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" /><TextBlock Text=" · " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding EvidenceCount, StringFormat={}{0} evidência(s) local(is)}" Style="{StaticResource CaptionText}" FontSize="10" /></StackPanel></StackPanel>
                                                 </Grid>
                                                 <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                                     <Button Content="Aprovar localmente" AutomationProperties.Name="Aprovar entrega localmente" Style="{StaticResource AccentButton}" Click="ApproveDelivery_Click"><Button.IsEnabled><MultiBinding Converter="{StaticResource BooleanAndConverter}"><Binding Path="CanApprove" /><Binding Path="DataContext.SelectedProject.IsOpen" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" /></MultiBinding></Button.IsEnabled></Button>
                                                     <Button Content="Registrar integração" AutomationProperties.Name="Registrar integração local" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="IntegrateDelivery_Click"><Button.IsEnabled><MultiBinding Converter="{StaticResource BooleanAndConverter}"><Binding Path="CanIntegrate" /><Binding Path="DataContext.SelectedProject.IsOpen" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" /></MultiBinding></Button.IsEnabled></Button>
                                                 </WrapPanel>
                                             </StackPanel>
                                         </Border>
                                     </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,10,0,0"><TextBlock Text="QUALIDADE E HISTÓRICO" Style="{StaticResource SectionTitle}" Margin="0" /><Button Content="Executar checks" AutomationProperties.Name="Executar checks locais" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" IsEnabled="{Binding SelectedProject.IsOpen}" Click="RunQuality_Click" /></Grid>
                            <ItemsControl ItemsSource="{Binding SelectedProject.QualityChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Grid.Column="0" Style="{StaticResource ActivityDotStyle}" Margin="0,4,0,0" /><StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" /><TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel></Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><StackPanel><TextBlock Text="PUBLICAÇÃO" Style="{StaticResource CaptionText}" Foreground="{StaticResource AmberBrush}" /><TextBlock Text="release local → integração local → deploy não conectado" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" /><TextBlock Text="Nenhum desses estados cria branch, pipeline ou produção nesta fase." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
